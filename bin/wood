#!/data/data/com.termux/files/usr/bin/env python3
# wood — collecteur passif de beacons Wi-Fi + GPS, temps réel (Termux)
import json, subprocess, sqlite3, time, sys, os, argparse, threading, csv as _csv
from datetime import datetime, timezone

DB = os.path.expanduser("~/.wood/wood.db")
SCAN_INTERVAL = 2
LOC_INTERVAL  = 30
VERSION = "0.3.0"

# ---------- état partagé ----------
_lock   = threading.Lock()
_store  = {}   # bssid -> {bssid, ssid, canal, securite, rssi, freq, vu_count, last}
_pos    = {"lat": None, "lon": None, "prec": None}
_stop   = threading.Event()
_filtre = {"open": False, "ch": None}

# ---------- constructeurs (OUI) ----------
OUI = {"00:50:56": "VMware", "00:0C:29": "VMware", "00:05:69": "VMware",
       "B8:27:EB": "Raspberry Pi", "DC:A6:32": "Raspberry Pi", "E4:5F:01": "Raspberry Pi"}

def charger_oui():
    f = os.path.expanduser("~/.wood/oui.csv")  # format: AABBCC,Constructeur  (ou AA:BB:CC,...)
    if not os.path.exists(f): return
    for line in open(f, encoding="utf-8", errors="ignore"):
        p = line.strip().split(",", 1)
        if len(p) != 2: continue
        pref = p[0].replace("-", ":").replace(".", ":").upper()
        if len(pref) == 6:
            pref = ":".join(pref[i:i+2] for i in range(0, 6, 2))
        OUI[pref] = p[1].strip()

def vendor(bssid):
    if not bssid: return ""
    return OUI.get(bssid[:8].upper(), "")

# ---------- base ----------
def connexion():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    con = sqlite3.connect(DB, check_same_thread=False)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("""CREATE TABLE IF NOT EXISTS releves (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        vu_le TEXT, bssid TEXT, ssid TEXT, canal INTEGER,
        freq INTEGER, rssi INTEGER, securite TEXT,
        lat REAL, lon REAL, precision_m REAL)""")
    con.commit()
    return con

# ---------- helpers ----------
def freq_vers_canal(mhz):
    if not mhz: return None
    if mhz == 2484: return 14
    if 2412 <= mhz <= 2472: return (mhz - 2412)//5 + 1
    if 5000 <= mhz <= 5900: return (mhz - 5000)//5
    return None

def cmd_json(args, timeout=60):
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        txt = out.stdout.strip()
        return json.loads(txt) if txt else None
    except Exception:
        return None

def scanner():
    d = cmd_json(["termux-wifi-scaninfo"])
    return d if isinstance(d, list) else []

def position():
    # Positionnement réseau : rapide, ne bloque pas le scan Wi-Fi (Termux:API
    # ne traite qu'une requête à la fois). Précision grossière mais fonctionnelle.
    loc = cmd_json(["termux-location", "-p", "network"], timeout=25)
    if loc and loc.get("latitude") is not None:
        return (loc.get("latitude"), loc.get("longitude"), loc.get("accuracy"))
    return (None, None, None)

def norm(r):
    freq = r.get("frequency_mhz") or r.get("frequency")
    return {"bssid": r.get("bssid"),
            "ssid": r.get("ssid") or "(masqué)",
            "canal": freq_vers_canal(freq), "freq": freq,
            "rssi": r.get("rssi") or r.get("level"),
            "securite": r.get("capabilities") or r.get("security") or ""}

def est_ouvert(s):
    return ("WPA" not in s) and ("WEP" not in s)

def secu_tag(s):
    for t in ("WPA3", "WPA2", "WPA", "WEP"):
        if t in s: return t
    return "OPEN"

# ---------- moteur temps réel ----------
def _boucle_scan(con):
    while not _stop.is_set():
        reseaux = scanner()
        vu = datetime.now(timezone.utc).isoformat()
        with _lock:
            lat, lon, prec = _pos["lat"], _pos["lon"], _pos["prec"]
        rows = []
        for raw in reseaux:
            r = norm(raw)
            if not r["bssid"]: continue
            rows.append((vu, r["bssid"], r["ssid"], r["canal"], r["freq"],
                         r["rssi"], r["securite"], lat, lon, prec))
            with _lock:
                e = _store.get(r["bssid"], {"vu_count": 0})
                e.update(bssid=r["bssid"], ssid=r["ssid"], canal=r["canal"],
                         securite=r["securite"], rssi=r["rssi"], freq=r["freq"], last=vu)
                e["vu_count"] += 1
                _store[r["bssid"]] = e
        if rows:
            with _lock:
                con.executemany(
                    "INSERT INTO releves (vu_le,bssid,ssid,canal,freq,rssi,securite,lat,lon,precision_m)"
                    " VALUES (?,?,?,?,?,?,?,?,?,?)", rows)
                con.commit()
        _stop.wait(SCAN_INTERVAL)

def _boucle_pos():
    while not _stop.is_set():
        lat, lon, prec = position()
        if lat is not None:          # garde la dernière position connue si la lecture échoue
            with _lock:
                _pos.update(lat=lat, lon=lon, prec=prec)
        _stop.wait(LOC_INTERVAL)

# ---------- affichage rich ----------
def _barre(rssi):
    from rich.text import Text
    if rssi is None: return Text("—")
    n = max(0, min(5, (rssi + 95)//12))
    col = "bright_green" if n >= 4 else "yellow" if n >= 2 else "red"
    return Text("█"*n + "░"*(5-n) + f" {rssi}", style=col)

def _secu(s):
    from rich.text import Text
    t = secu_tag(s)
    col = {"WPA3": "bright_green", "WPA2": "cyan", "WPA": "yellow",
           "WEP": "yellow", "OPEN": "bold red"}[t]
    return Text(t, col)

def _rendu():
    from rich.table import Table
    from rich.panel import Panel
    from rich.console import Group
    from rich.text import Text
    from rich import box
    with _lock:
        vals = list(_store.values()); tous = len(_store); pos = dict(_pos)
    if _filtre["open"]:
        vals = [e for e in vals if est_ouvert(e.get("securite", ""))]
    if _filtre["ch"] is not None:
        vals = [e for e in vals if e.get("canal") == _filtre["ch"]]
    items = sorted(vals, key=lambda e: (e.get("rssi") or -999), reverse=True)
    ouverts = sum(1 for e in _store.values() if est_ouvert(e.get("securite", "")))
    t = Table(expand=True, box=box.SIMPLE_HEAD, header_style="bold green",
              border_style="green", pad_edge=False, padding=(0, 1))
    t.add_column("SSID", ratio=2, no_wrap=True, overflow="ellipsis")
    t.add_column("Signal", no_wrap=True)
    t.add_column("Séc", width=4)
    t.add_column("Ch", justify="right", width=3)
    t.add_column("Borne", ratio=2, no_wrap=True, overflow="ellipsis")
    t.add_column("Vu", justify="right", width=3)
    for e in items[:40]:
        t.add_row(e.get("ssid", "?"), _barre(e.get("rssi")),
                  _secu(e.get("securite", "")), str(e.get("canal") or "?"),
                  vendor(e.get("bssid")) or e.get("bssid", ""), str(e.get("vu_count", 0)))
    if pos["lat"]:
        acc = f" ±{int(pos['prec'])}m" if pos.get("prec") else ""
        gps = f"GPS {pos['lat']:.5f},{pos['lon']:.5f}{acc}"
    else:
        gps = "GPS …"
    nb = f"{len(items)}/{tous}" if (_filtre["open"] or _filtre["ch"] is not None) else str(tous)
    entete = Text.assemble(
        ("WOOD ", "bold bright_green"), (f"v{VERSION}   ", "green"),
        (f"{os.cpu_count() or '?'} cœurs   ", "white"),
        (f"{nb} bornes   ", "bold white"),
        (f"{ouverts} ouvertes   ", "red"), (gps, "cyan"),
        ("   [Ctrl-C quitter]", "dim"))
    return Panel(Group(entete, t), border_style="green",
                 title="collecteur Wi-Fi passif — temps réel")

# ---------- commandes ----------
def cmd_live(a):
    try:
        from rich.live import Live
    except ImportError:
        print("Le module 'rich' manque.  Installe-le :  pip install rich"); return
    _filtre["open"] = getattr(a, "open", False)
    _filtre["ch"] = getattr(a, "ch", None)
    con = connexion()
    threading.Thread(target=_boucle_scan, args=(con,), daemon=True).start()
    threading.Thread(target=_boucle_pos, daemon=True).start()
    try:
        with Live(_rendu(), refresh_per_second=4, screen=True) as live:
            while not _stop.is_set():
                live.update(_rendu()); time.sleep(0.25)
    except KeyboardInterrupt:
        pass
    finally:
        _stop.set(); time.sleep(0.3); con.close()
        with _lock:
            print(f"arrêt. {len(_store)} bornes uniques vues cette session.")

def cmd_scan(a):
    con = connexion()
    lat, lon, prec = position()
    reseaux = scanner()
    vu = datetime.now(timezone.utc).isoformat()
    for raw in reseaux:
        r = norm(raw)
        con.execute("INSERT INTO releves (vu_le,bssid,ssid,canal,freq,rssi,securite,lat,lon,precision_m)"
                    " VALUES (?,?,?,?,?,?,?,?,?,?)",
                    (vu, r["bssid"], r["ssid"], r["canal"], r["freq"], r["rssi"], r["securite"], lat, lon, prec))
    con.commit()
    print(f"{len(reseaux)} réseaux captés et enregistrés.\n")
    for raw in reseaux:
        r = norm(raw)
        marque = vendor(r["bssid"]) or r["bssid"]
        print(f"   {r['ssid']:<22} {marque:<18} canal {r['canal']}  {r['rssi']} dBm  {secu_tag(r['securite'])}")
    con.close()

def cmd_stats(a):
    con = connexion(); q = con.execute
    total = q("SELECT COUNT(*) FROM releves").fetchone()[0]
    if total == 0:
        print("Base vide. Lance 'wood' (temps réel) ou 'wood scan'."); con.close(); return
    uniq = q("SELECT COUNT(DISTINCT bssid) FROM releves").fetchone()[0]
    print(f"Relevés enregistrés : {total}\nBornes uniques      : {uniq}\n\nPar type de sécurité :")
    for sec, n in q("""SELECT CASE
                WHEN securite LIKE '%WPA3%' THEN 'WPA3'
                WHEN securite LIKE '%WPA2%' THEN 'WPA2'
                WHEN securite LIKE '%WPA%'  THEN 'WPA'
                WHEN securite LIKE '%WEP%'  THEN 'WEP'
                ELSE 'ouvert' END t, COUNT(DISTINCT bssid)
                FROM releves GROUP BY t ORDER BY 2 DESC""").fetchall():
        print(f"   {sec:<8} {n}")
    print("\nTop 5 bornes les plus vues :")
    for ssid, bssid, n in q("""SELECT ssid,bssid,COUNT(*) c FROM releves
                GROUP BY bssid ORDER BY c DESC LIMIT 5""").fetchall():
        print(f"   {ssid:<22} {bssid}  ({n}×)")
    con.close()

def cmd_channels(a):
    con = connexion()
    rows = con.execute("SELECT canal, COUNT(DISTINCT bssid) FROM releves GROUP BY canal ORDER BY canal").fetchall()
    con.close()
    if not rows:
        print("Base vide."); return
    maxn = max(n for _, n in rows)
    print("Occupation des canaux (bornes distinctes) :\n")
    for canal, n in rows:
        barre = "█" * int(n / maxn * 30) if maxn else ""
        print(f"  canal {str(canal if canal is not None else '?'):>3} | {barre} {n}")
    print("\n(2,4 GHz : préfère 1, 6 ou 11, qui ne se chevauchent pas.)")

def cmd_twins(a):
    con = connexion()
    rows = con.execute("""SELECT ssid, bssid, securite, canal, MAX(rssi)
        FROM releves WHERE ssid!='' AND ssid!='(masqué)'
        GROUP BY bssid ORDER BY ssid""").fetchall()
    con.close()
    groupes = {}
    for ssid, bssid, sec, canal, rssi in rows:
        groupes.setdefault(ssid, []).append((bssid, sec, canal, rssi))
    suspects = {s: v for s, v in groupes.items() if len(v) > 1}
    if not suspects:
        print("Aucun SSID porté par plusieurs bornes. Rien à signaler."); return
    print("SSID portés par PLUSIEURS bornes (BSSID différents) :\n")
    for ssid, liste in suspects.items():
        tags = {secu_tag(s) for _, s, _, _ in liste}
        fort = "  ⚠ SÉCURITÉS DIFFÉRENTES (clone ouvert ?)" if len(tags) > 1 else ""
        print(f"• {ssid}  —  {len(liste)} bornes{fort}")
        for bssid, sec, canal, rssi in liste:
            print(f"     {bssid}  {vendor(bssid) or '?':<14} {secu_tag(sec):<5} canal {canal}  {rssi} dBm")
        print()
    print("Note : plusieurs BSSID pour un SSID, c'est SOUVENT normal (une box a")
    print("une radio 2,4 GHz + une 5 GHz, un mesh a plusieurs bornes). Le vrai")
    print("drapeau rouge = même nom mais sécurité qui change (ex. une copie OPEN")
    print("d'un réseau WPA2) ou un constructeur incohérent.")

def cmd_export(a):
    con = connexion()
    rows = con.execute("SELECT vu_le,bssid,ssid,canal,freq,rssi,securite,lat,lon,precision_m FROM releves").fetchall()
    con.close()
    if not rows:
        print("Base vide."); return
    cols = ["vu_le", "bssid", "ssid", "canal", "freq", "rssi", "securite", "lat", "lon", "precision_m"]
    out = os.path.expanduser(f"~/.wood/export.{a.format}")
    if a.format == "csv":
        with open(out, "w", newline="", encoding="utf-8") as f:
            w = _csv.writer(f); w.writerow(cols); w.writerows(rows)
    elif a.format == "json":
        with open(out, "w", encoding="utf-8") as f:
            json.dump([dict(zip(cols, r)) for r in rows], f, ensure_ascii=False, indent=1)
    elif a.format == "gpx":
        con = connexion()
        pts = con.execute("""SELECT ssid,bssid,securite,canal,AVG(lat),AVG(lon)
            FROM releves WHERE lat IS NOT NULL GROUP BY bssid""").fetchall()
        con.close()
        with open(out, "w", encoding="utf-8") as f:
            f.write('<?xml version="1.0"?>\n<gpx version="1.1" creator="wood">\n')
            for ssid, bssid, sec, canal, lat, lon in pts:
                f.write(f'  <wpt lat="{lat}" lon="{lon}"><name>{ssid}</name>'
                        f'<desc>{bssid} | {secu_tag(sec)} | canal {canal}</desc></wpt>\n')
            f.write("</gpx>\n")
    print(f"Export écrit : {out}  ({len(rows)} relevés)")

def cmd_map(a):
    con = connexion()
    rows = con.execute("""SELECT bssid, ssid, securite, canal, AVG(lat), AVG(lon), MAX(rssi), COUNT(*)
        FROM releves WHERE lat IS NOT NULL GROUP BY bssid""").fetchall()
    con.close()
    pts = [{"bssid": b, "ssid": s, "sec": secu_tag(sec), "canal": c,
            "lat": lat, "lon": lon, "rssi": rssi, "n": n, "constr": vendor(b)}
           for b, s, sec, c, lat, lon, rssi, n in rows]
    if not pts:
        print("Aucun relevé géolocalisé. Active le GPS puis relance 'wood' en te déplaçant.")
        return
    html = CARTE.replace("__POINTS__", json.dumps(pts))
    out = os.path.expanduser("~/.wood/carte.html")
    open(out, "w", encoding="utf-8").write(html)
    import http.server, socketserver, functools
    class Serveur(socketserver.TCPServer):
        allow_reuse_address = True
    handler = functools.partial(http.server.SimpleHTTPRequestHandler,
                                directory=os.path.dirname(out))
    # port 0 = l'OS attribue un port libre -> aucun conflit avec tes autres services
    httpd = Serveur(("127.0.0.1", 0), handler)
    port = httpd.server_address[1]
    url = f"http://127.0.0.1:{port}/carte.html"
    print(f"Carte générée : {len(pts)} bornes géolocalisées.")
    try:
        subprocess.run(["termux-open-url", url])
    except FileNotFoundError:
        print("Ouvre dans ton navigateur :", url)
    print(f"Service local actif sur {url}")
    print("Ctrl-C pour arrêter le serveur quand tu as fini de regarder la carte.")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\narrêt du serveur.")
    finally:
        httpd.shutdown()

def cmd_track(a):
    try:
        from rich.live import Live
        from rich.panel import Panel
        from rich.text import Text
        from rich.align import Align
    except ImportError:
        print("Le module 'rich' manque.  pip install rich"); return
    cible = a.bssid.strip().lower()
    prev = {"rssi": None}
    def rendu():
        r = None
        for raw in scanner():
            n = norm(raw)
            if n["bssid"] and n["bssid"].lower() == cible:
                r = n; break
        if not r:
            return Panel(Align.center(Text("borne non détectée sur ce scan…\n(hors de portée ?)", "red")),
                         title=f"track {cible}", border_style="red")
        rssi = r["rssi"]; p = prev["rssi"]
        tend = "— premier relevé" if p is None else (
            "↑  TU TE RAPPROCHES" if rssi > p else "↓  tu t'éloignes" if rssi < p else "=  stable")
        prev["rssi"] = rssi
        n = max(0, min(20, (rssi + 95)//3))
        col = "bright_green" if rssi > -55 else "yellow" if rssi > -75 else "red"
        corps = Text()
        corps.append((r["ssid"] or "(masqué)") + "\n\n", "bold white")
        corps.append("█"*n + "░"*(20-n) + "\n\n", col)
        corps.append(f"{rssi} dBm\n\n", "bold " + col)
        corps.append(tend, "bold")
        return Panel(Align.center(corps), title=f"track {cible}  —  Ctrl-C quitter", border_style="green")
    try:
        with Live(rendu(), refresh_per_second=2, screen=True) as live:
            while True:
                live.update(rendu()); time.sleep(SCAN_INTERVAL)
    except KeyboardInterrupt:
        pass

def cmd_upgrade(a):
    src_file = os.path.expanduser("~/.wood/source")
    if not os.path.exists(src_file):
        print("Source inconnue. Refais une fois :  cd wood && bash install.sh"); return
    src = open(src_file).read().strip()
    print(f"Mise à jour depuis {src} ...")
    if subprocess.run(["git", "-C", src, "pull"]).returncode != 0:
        print("Échec du git pull (réseau ? dépôt déplacé ?)."); return
    prefix = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
    subprocess.run(["install", "-m", "755", os.path.join(src, "bin", "wood"),
                    os.path.join(prefix, "bin", "wood")])
    subprocess.run([sys.executable, "-m", "pip", "install", "-q", "--upgrade", "rich"])
    print("wood est à jour. Relance 'wood'.")

# ---------- gabarit carte ----------
CARTE = """<!DOCTYPE html><html><head><meta charset="utf-8">
<title>wood — carte Wi-Fi</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>html,body,#m{height:100%;margin:0}</style></head>
<body><div id="m"></div><script>
var pts=__POINTS__;
// Bornes captées au même endroit (ex. collecte immobile) : on les écarte
// en petit cercle (~9 m) pour qu'elles soient toutes visibles et comptables.
var groupes={};
pts.forEach(function(p){var k=p.lat.toFixed(5)+','+p.lon.toFixed(5);
  (groupes[k]=groupes[k]||[]).push(p);});
Object.keys(groupes).forEach(function(k){var g=groupes[k];
  if(g.length>1){var R=0.00008;
    g.forEach(function(p,i){var a=2*Math.PI*i/g.length;
      p.lat+=R*Math.cos(a); p.lon+=R*Math.sin(a);});}});
var map=L.map('m');
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
 {maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);
var grp=[];
pts.forEach(function(p){
 var coul = p.sec==='OPEN' ? 'red' : (p.sec==='WEP' ? 'orange' : 'green');
 var m=L.circleMarker([p.lat,p.lon],{radius:7,color:coul,fillOpacity:.7}).addTo(map);
 m.bindPopup('<b>'+(p.ssid||'(masqué)')+'</b><br>'+p.bssid+
   (p.constr?(' ('+p.constr+')'):'')+'<br>'+p.sec+' · canal '+p.canal+
   '<br>signal max '+p.rssi+' dBm · vu '+p.n+'×');
 grp.push([p.lat,p.lon]);
});
if(grp.length) map.fitBounds(grp,{padding:[30,30]}); else map.setView([0,0],2);
</script></body></html>"""

def main():
    charger_oui()
    p = argparse.ArgumentParser(prog="wood", description="Collecteur passif de beacons Wi-Fi, temps réel (Termux)")
    sub = p.add_subparsers(dest="cmd")
    pl = sub.add_parser("live", help="dashboard temps réel (défaut)")
    pl.add_argument("--open", action="store_true", help="n'afficher que les réseaux ouverts")
    pl.add_argument("--ch", type=int, help="n'afficher qu'un canal")
    sub.add_parser("scan", help="un scan unique immédiat")
    sub.add_parser("stats", help="bilan de la base")
    sub.add_parser("channels", help="occupation des canaux")
    sub.add_parser("twins", help="détecte les SSID à plusieurs bornes (evil twin)")
    sub.add_parser("map", help="génère une carte HTML des bornes géolocalisées")
    pe = sub.add_parser("export", help="exporte la base (csv/json/gpx)")
    pe.add_argument("format", nargs="?", default="csv", choices=["csv", "json", "gpx"])
    pt = sub.add_parser("track", help="suit le signal d'une borne (BSSID)")
    pt.add_argument("bssid")
    sub.add_parser("update", help="met à jour wood depuis GitHub")
    sub.add_parser("upgrade", help="met à jour wood depuis GitHub (alias)")
    a = p.parse_args()
    cmds = {"live": cmd_live, "scan": cmd_scan, "stats": cmd_stats, "channels": cmd_channels,
            "twins": cmd_twins, "map": cmd_map, "export": cmd_export, "track": cmd_track,
            "update": cmd_upgrade, "upgrade": cmd_upgrade}
    cmds.get(a.cmd, cmd_live)(a)

if __name__ == "__main__":
    main()
